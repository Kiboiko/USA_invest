# Скопируйте файл в `.env` и подставьте свои значения.
# Все переменные необязательные: без них проект работает, но форма пишет
# данные только в консоль браузера (режим "endpoint не настроен").

# URL Google Apps Script Web App (заканчивается на /exec)
VITE_SHEETS_ENDPOINT=

# Тот же секрет, что и SHARED_TOKEN в apps-script/Code.gs (можно оставить пустым)
VITE_SHEETS_TOKEN=

# Аналитика. Если пусто — скрипты не подключаются вообще.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
